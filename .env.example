# Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Optional GitHub personal access token for higher API rate limits.
GITHUB_TOKEN=

# Optional: sync slash commands to this development server for faster updates.
DEV_GUILD_ID=

# Optional Python logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Optional Discord channels. If unset, the bot looks them up by name in DEV_GUILD_ID.
NEW_REPOSITORIES_CHANNEL_ID=
TRENDING_PROJECTS_CHANNEL_ID=
AI_ML_PROJECTS_CHANNEL_ID=
CYBERSECURITY_PROJECTS_CHANNEL_ID=

# Discovery scan settings.
DISCOVERY_MIN_STARS=100
DISCOVERY_LANGUAGE=
DISCOVERY_TOPICS=
DISCOVERY_RESULT_LIMIT=30
TRENDING_SCORE_THRESHOLD=70

# Automatic repository scanning. Set SCAN_ENABLED=false to disable scheduling.
SCAN_INTERVAL_MINUTES=30
SCAN_ENABLED=true
